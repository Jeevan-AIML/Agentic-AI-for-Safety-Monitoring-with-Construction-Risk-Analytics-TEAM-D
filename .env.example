# =====================================================
# ACRIP - Agentic Construction Risk Intelligence Platform
# Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================

# --- Application ---
APP_NAME="ACRIP - Agentic Construction Risk Intelligence Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# --- Database ---
# Use SQLite for local development (zero setup)
DATABASE_URL=sqlite:///./acrip_dev.db
# Use PostgreSQL for production:
# DATABASE_URL=postgresql://username:password@localhost:5432/acrip_db

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Demo Users (for seeding) ---
# Passwords are bcrypt hashed - these are development defaults only
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_MANAGER_PASSWORD=Manager@123
DEMO_SITE_MANAGER_PASSWORD=SiteManager@123
DEMO_SAFETY_PASSWORD=Safety@123
DEMO_VIEWER_PASSWORD=Viewer@123

# --- Future: AI Agent Keys ---
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Future: Notifications ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@acriplatform.com
# SMTP_PASSWORD=your-smtp-password
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...

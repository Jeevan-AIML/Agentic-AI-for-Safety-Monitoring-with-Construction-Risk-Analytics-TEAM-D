# ==============================================================================
# ACRIP — Agentic AI for Safety Monitoring with Construction Risk Analytics
# Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (Security Critical)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
frontend/.env
*.local
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging

# API keys, tokens, private keys and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
*.token
credentials.json
secrets.json

# PRESERVE safe environment templates and documentation
!.env.example
!.env.template
!*.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 2. Python (Virtual Environments, Bytecode & Cache)
# ------------------------------------------------------------------------------
# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
ENV.bak/
bin/
include/
lib/
lib64/
share/

# Bytecode & Caches (applied globally and recursively)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Testing & Type Checking caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
nosetests.xml

# Packaging & distribution
build/
*.egg-info/
.eggs/
eggs/
dist/*.whl
dist/*.tar.gz

# ------------------------------------------------------------------------------
# 3. Node / React / Vite (Frontend)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/

# Frontend build outputs
frontend/dist/
dist/
dist-ssr/
*.tsbuildinfo

# Vite cache
.vite/
frontend/.vite/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Database & Runtime SQLite Storage
# ------------------------------------------------------------------------------
# Local SQLite database files & WAL journals
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# PRESERVE database schema, migrations, seeders, and configuration
!schema.sql
!*.sql
!migrations/
!backend/app/seed.py
!backend/app/database/**

# ------------------------------------------------------------------------------
# 5. Runtime Uploads, Temporary Files & Logs
# ------------------------------------------------------------------------------
# Local user uploads and test media
backend/uploads/**
!backend/uploads/
!backend/uploads/**/.gitkeep

# Application logs & test execution outputs
*.log
logs/
backend/*.log
test_output.txt
backend/test_output.txt

# Editor and general temporary/swap files
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.orig

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ------------------------------------------------------------------------------
# 7. IDE & Editor Files
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# VS Code: Ignore local workspace state, preserve shared configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 8. AI IDE & Local Assistant Artifacts
# ------------------------------------------------------------------------------
.gemini/
.agents/
.antigravity/
.system_generated/

# ------------------------------------------------------------------------------
# 9. Explicit Safeguards for Core ACRIP Architecture & Assets
# ------------------------------------------------------------------------------
# Source code safeguards
!backend/requirements.txt
!backend/test_runner.py
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/tailwind.config.js
!frontend/postcss.config.js
!frontend/index.html
!README.md

# Ensure bytecode is never tracked even inside source subdirectories
**/__pycache__/**
*.py[cod]
